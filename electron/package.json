{
  "name": "rp-hand-electron",
  "version": "1.0.0",
  "description": "RP-Hand Gesture desktop interface",
  "author": "RoboParty",
  "license": "MIT",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "build:python": "powershell -ExecutionPolicy Bypass -File build-python.ps1",
    "dist:win": "npm run test && npm run build:python && electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "44.0.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.roboparty.rphand",
    "productName": "RP-Hand Gesture",
    "artifactName": "${productName} Setup ${version}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "backend-lifecycle.cjs",
      "bridge-protocol.cjs",
      "log-forwarder.cjs",
      "process-termination.cjs",
      "renderer/**/*"
    ],
    "extraResources": [
      {
        "from": "../dist/RP-Hand",
        "to": "RP-Hand"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "../assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
